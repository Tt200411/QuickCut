{
  "mode": "fixed_model_response",
  "note": "人工固定的模型响应夹具，用来在接入本地 Qwen 之前测试校验器，不是一次真实推理记录。",
  "beats": {
    "beat-open": {
      "shot_order": ["candidate-seg-packing"],
      "reasons": {
        "candidate-seg-packing": "用户素材里的出发动作，承担开场事件证据"
      },
      "roles": {
        "candidate-seg-packing": "primary"
      }
    },
    "beat-middle": {
      "shot_order": ["candidate-seg-forest", "candidate-seg-walk"],
      "reasons": {
        "candidate-seg-forest": "授权空镜建立林间环境，不声明为用户实际抵达的地点",
        "candidate-seg-walk": "用户素材里的步行，承接环境并推动事件"
      },
      "roles": {
        "candidate-seg-forest": "establishing",
        "candidate-seg-walk": "primary"
      }
    },
    "beat-close": {
      "shot_order": ["candidate-seg-rest"],
      "reasons": {
        "candidate-seg-rest": "用户素材里的休息动作，收束情绪"
      },
      "roles": {
        "candidate-seg-rest": "primary"
      }
    }
  }
}
