    "cues": [
      {
        "start": 0.0,
        "end": 3.0,
        "text": "树林里，大白兔守在树下。"
      },
      {
        "start": 3.0,
        "end": 9.0,
        "text": "它的对手爬上高处，沿着枝干步步逼近。"
      },
      {
        "start": 9.0,
        "end": 15.0,
        "text": "这只飞鼠盯紧目标，准备亮出滑翔的本领。"
      },
      {
        "start": 15.0,
        "end": 21.0,
        "text": "四肢一展，它纵身跃起，从树梢飞向林间。"
      },
      {
        "start": 21.0,
        "end": 27.0,
        "text": "一颗果实也从高处坠落，危险渐渐显露。"
      },
      {
        "start": 27.0,
        "end": 33.0,
        "text": "地面露出一排尖桩，轻松的滑翔顿时变成险境。"
      },
      {
        "start": 33.0,
        "end": 39.0,
        "text": "飞鼠贴着尖桩掠过，及时抓住树枝，躲开了一劫。"
      },
      {
        "start": 39.0,
        "end": 45.0,
        "text": "可它刚站稳脚步，才发现大白兔已经等在眼前。"
      },
      {
        "start": 45.0,
        "end": 51.0,
        "text": "大手一伸，这位空中高手，只能乖乖束手就擒。"
      },
      {
        "start": 51.0,
        "end": 55.5,
        "text": "再飞起来时，它已成了兔子手中的风筝。"
      },
      {
        "start": 55.5,
        "end": 58.5,
        "text": "风波平息，大白兔终于笑了。"
      }
    ]
  },
