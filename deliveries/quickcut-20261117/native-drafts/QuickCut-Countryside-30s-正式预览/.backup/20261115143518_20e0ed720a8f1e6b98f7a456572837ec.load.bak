    "texts": [
      {
        "id": "212AAF5F-A2CC-552B-B9B0-BF7CF01E6F45",
        "content": "{\"text\": \"沿着郊外的小路，看看路边的风景。\", \"styles\": [{\"fill\": {\"alpha\": 1.0, \"content\": {\"render_type\": \"solid\", \"solid\": {\"alpha\": 1.0, \"color\": [1.0, 1.0, 1.0]}}}, \"range\": [0, 16], \"size\": 8.0, \"bold\": false, \"italic\": false, \"underline\": false, \"strokes\": []}]}",
        "typesetting": 0,
        "alignment": 1,
        "letter_spacing": 0.0,
        "line_spacing": 0.02,
        "line_feed": 1,
        "line_max_width": 0.82,
        "force_apply_line_max_width": false,
        "check_flag": 7,
        "type": "subtitle",
        "global_alpha": 1.0
      },
      {
        "id": "E7F89499-6250-5E82-A45B-849F5D196BC0",
        "content": "{\"text\": \"放慢脚步，留一点时间给身边的自然。\", \"styles\": [{\"fill\": {\"alpha\": 1.0, \"content\": {\"render_type\": \"solid\", \"solid\": {\"alpha\": 1.0, \"color\": [1.0, 1.0, 1.0]}}}, \"range\": [0, 17], \"size\": 8.0, \"bold\": false, \"italic\": false, \"underline\": false, \"strokes\": []}]}",
        "typesetting": 0,
        "alignment": 1,
        "letter_spacing": 0.0,
        "line_spacing": 0.02,
        "line_feed": 1,
        "line_max_width": 0.82,
        "force_apply_line_max_width": false,
        "check_flag": 7,
        "type": "subtitle",
        "global_alpha": 1.0
      },
      {
        "id": "A130C5B5-50C4-5AAD-BD9E-64F61EE59AEE",
        "content": "{\"text\": \"让这段散步，在柔和的光线里收尾。\", \"styles\": [{\"fill\": {\"alpha\": 1.0, \"content\": {\"render_type\": \"solid\", \"solid\": {\"alpha\": 1.0, \"color\": [1.0, 1.0, 1.0]}}}, \"range\": [0, 16], \"size\": 8.0, \"bold\": false, \"italic\": false, \"underline\": false, \"strokes\": []}]}",
        "typesetting": 0,
        "alignment": 1,
        "letter_spacing": 0.0,
        "line_spacing": 0.02,
        "line_feed": 1,
        "line_max_width": 0.82,
        "force_apply_line_max_width": false,
        "check_flag": 7,
        "type": "subtitle",
        "global_alpha": 1.0
      }
    ],
